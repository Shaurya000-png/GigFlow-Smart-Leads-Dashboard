# Server
PORT=5000
NODE_ENV=development

# Database (local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/gigflow

# Auth
JWT_SECRET=replace_with_a_long_random_secret_min_16_chars
JWT_EXPIRES_IN=7d

# CORS — frontend URL for local dev (Vite default)
FRONTEND_URL=http://localhost:5173

# Production: comma-separated allowed origins (Vercel + custom domains)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com

# Security: set true only in controlled environments to allow admin self-registration
ALLOW_ADMIN_REGISTER=false
